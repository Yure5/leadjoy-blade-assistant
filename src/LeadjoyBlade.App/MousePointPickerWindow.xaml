<Window x:Class="LeadjoyBlade.App.MousePointPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置鼠标位置" Width="640" Height="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowActivated="True" Focusable="True" Opacity="0"
        Cursor="None" SnapsToDevicePixels="True"
        Loaded="OnLoaded" Closed="OnClosed"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseMove="OnMouseMove" MouseLeftButtonDown="OnMouseDown" MouseLeftButtonUp="OnMouseUp">
    <Grid x:Name="Root" Background="Transparent">
        <!-- 半透明遮罩 -->
        <Rectangle x:Name="Dim" Fill="#8C000000" IsHitTestVisible="False" />
        <Border x:Name="TargetFrame" BorderBrush="#557FB8FF" BorderThickness="1"
                IsHitTestVisible="False" />

        <!-- 跟随鼠标的圆形十字准星 -->
        <Canvas IsHitTestVisible="False">
            <Grid x:Name="CursorMarker" Width="34" Height="34" Visibility="Collapsed">
                <Ellipse Stroke="#FFD76A" StrokeThickness="1.6" Fill="#22FFD76A" />
                <Line X1="17" Y1="2" X2="17" Y2="10" Stroke="#FFD76A" StrokeThickness="1.4" />
                <Line X1="17" Y1="24" X2="17" Y2="32" Stroke="#FFD76A" StrokeThickness="1.4" />
                <Line X1="2" Y1="17" X2="10" Y2="17" Stroke="#FFD76A" StrokeThickness="1.4" />
                <Line X1="24" Y1="17" X2="32" Y2="17" Stroke="#FFD76A" StrokeThickness="1.4" />
                <Ellipse Width="4" Height="4" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- 已记录的点：固定准星，可拖动 -->
            <Grid x:Name="FixedMarker" Width="30" Height="30" Visibility="Collapsed">
                <Ellipse Stroke="#7FB8FF" StrokeThickness="2" Fill="#337FB8FF" />
                <Ellipse Width="6" Height="6" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- 实时坐标 -->
            <Border x:Name="CoordBadge" Background="#E61B2433" BorderBrush="#667FB8FF"
                    BorderThickness="1" CornerRadius="6" Padding="8,4" Visibility="Collapsed">
                <TextBlock x:Name="CoordText" Foreground="#F8FBFF" FontSize="12" />
            </Border>
        </Canvas>

        <!-- 底部提示 -->
        <Border Background="#CC101820" CornerRadius="8" Padding="14,7"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="#FFD76A" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="左键点击设定坐标 · 按住准星拖动微调 · ESC 保存并退出"
                           Foreground="#AFC0D2" FontSize="11" Margin="0,3,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

