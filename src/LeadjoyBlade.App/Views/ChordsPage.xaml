<UserControl x:Class="LeadjoyBlade.App.Views.ChordsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="960">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="组合键" Style="{StaticResource H1}" />
            </StackPanel>
            <Button Grid.Column="1" Content="＋ 添加组合键" Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Center" Click="Add_OnClick" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💡" Margin="0,0,8,0" />
                <TextBlock Text="如需使用组合键，不建议对组合键的首键位做单键的按键映射，避免误触发单键动作。"
                           Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <ListBox x:Name="ChordList">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,2" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding SourcesText}" Style="{StaticResource Muted}" FontSize="10" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="5" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ActionKind}" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                    </Border>
                                    <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" Foreground="{DynamicResource Text}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="编辑" Style="{StaticResource BtnBase}" Padding="10,4" FontSize="11" Click="Edit_OnClick" />
                                    <Button Content="删除" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11"
                                            Foreground="{DynamicResource TextMuted}" Click="Delete_OnClick" Margin="4,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="还没有组合键。点击右上角添加，例如把 Fn + Start 映射为 Enter。"
                           Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

