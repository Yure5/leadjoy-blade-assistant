<UserControl x:Class="LeadjoyBlade.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="960">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="设置" Style="{StaticResource H1}" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="配置管理" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="选择配置" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <ComboBox x:Name="ProfileSelectCombo" Grid.Column="1" SelectionChanged="ProfileSelect_OnSelectionChanged" />
                        <Button Content="删除" Grid.Column="3" Style="{StaticResource BtnBase}" Margin="8,0,0,0" Click="DeleteProfile_OnClick" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="配置名称" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <TextBox x:Name="ProfileNameBox" Grid.Column="1" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="自动切换程序" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="ProcessBox" />
                            <TextBlock Text="填写程序的进程名或产品名" IsHitTestVisible="False" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Opacity="0.55">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=ProcessBox}" Value="" />
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ProcessBox}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <CheckBox x:Name="KeepProfileCheck" Content="进程窗口非激活时保持当前配置" Margin="0,2,0,4" Click="Setting_OnChanged" />
                    <TextBlock Text="不勾选时，进程窗口失焦会自动切换到默认配置。"
                               Style="{StaticResource Muted}" FontSize="10" Margin="24,0,0,10" />
                    <CheckBox x:Name="ImeCheck" Content="本配置启用手柄输入法" Margin="0,2,0,4"
                              Checked="ImeCheck_OnChanged" Unchecked="ImeCheck_OnChanged" />
                    <StackPanel Orientation="Horizontal" Margin="110,2,0,0">
                        <Button Content="保存配置信息" Style="{StaticResource PrimaryButton}" Click="SaveProfile_OnClick" />
                        <Button Content="新建配置" Style="{StaticResource BtnBase}" Margin="8,0,0,0" Click="NewProfile_OnClick" />
                        <Button Content="导入配置" Style="{StaticResource BtnBase}" Margin="8,0,0,0" Click="ImportProfiles_OnClick" />
                        <Button Content="导出配置" Style="{StaticResource BtnBase}" Margin="8,0,0,0" Click="ExportProfiles_OnClick" />
                        <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OpenData_OnClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="摇杆与扳机" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="左摇杆死区" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <Slider x:Name="LeftDeadzoneSlider" Grid.Column="1" Minimum="5" Maximum="80" TickFrequency="1"
                                VerticalAlignment="Center" ValueChanged="Deadzone_OnChanged" />
                        <TextBlock x:Name="LeftDeadzoneText" Grid.Column="2" Text="25%" HorizontalAlignment="Right"
                                   Style="{StaticResource Muted}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="右摇杆死区" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <Slider x:Name="RightDeadzoneSlider" Grid.Column="1" Minimum="5" Maximum="80" TickFrequency="1"
                                VerticalAlignment="Center" ValueChanged="Deadzone_OnChanged" />
                        <TextBlock x:Name="RightDeadzoneText" Grid.Column="2" Text="25%" HorizontalAlignment="Right"
                                   Style="{StaticResource Muted}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="140,4,0,10">
                        <CheckBox x:Name="InvertLeftCheck" Content="反转左摇杆 Y 轴" Margin="0,0,20,0" Click="Setting_OnChanged" />
                        <CheckBox x:Name="InvertRightCheck" Content="反转右摇杆 Y 轴" Click="Setting_OnChanged" />
                    </StackPanel>
                    <Border Style="{StaticResource Divider}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <CheckBox x:Name="LeftTriggerFastCheck" Content="左扳机快速扳机" Margin="0,0,24,0" Click="Setting_OnChanged" />
                        <CheckBox x:Name="RightTriggerFastCheck" Content="右扳机快速扳机" Click="Setting_OnChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="启动与托盘" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <CheckBox x:Name="StartMappingCheck" Content="启动时默认开启映射" Margin="0,0,0,10" Click="Setting_OnChanged" />
                    <CheckBox x:Name="StartWithWindowsCheck" Content="开机自动启动" Margin="0,0,0,10" Click="Setting_OnChanged" />
                    <CheckBox x:Name="MinimizeToTrayCheck" Content="关闭窗口时最小化到托盘" Margin="0,0,0,10" Click="Setting_OnChanged" />
                    <CheckBox x:Name="AutoSwitchCheck" Content="根据前台程序自动切换配置" Margin="0,0,0,8" Click="Setting_OnChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource H2}" Margin="0,0,0,10" />
                        <TextBlock x:Name="AboutTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="AboutBody" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1" Margin="18,16,0,0" Padding="8,6" CornerRadius="12"
                            VerticalAlignment="Top" Cursor="Hand"
                            MouseLeftButtonUp="Bilibili_OnClick"
                            ToolTip="打开 B 站主页：space.bilibili.com/549549">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface2}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Width="112">
                            <Border Width="80" Height="80" CornerRadius="40" HorizontalAlignment="Center"
                                    BorderBrush="#33FFFFFF" BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush ImageSource="pack://application:,,,/LeadjoyBlade;component/Assets/bilibili_avatar.png"
                                                Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <TextBlock Text="B 站 · 幻色" HorizontalAlignment="Center" Margin="0,8,0,0"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="space.bilibili.com/549549" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       FontSize="8.5" Foreground="{DynamicResource TextMuted}" Opacity="0.7" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

