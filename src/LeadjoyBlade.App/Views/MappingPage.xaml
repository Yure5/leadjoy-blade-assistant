<UserControl x:Class="LeadjoyBlade.App.Views.MappingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="960">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="按键映射" Style="{StaticResource H1}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SaveHint" Text="修改会自动保存" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="＋ 添加映射" Style="{StaticResource PrimaryButton}" Click="Add_OnClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="鼠标指针映射" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="把摇杆整体当作鼠标指针，支持灵敏度与加速度"
                                   Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <ComboBox x:Name="StickCombo" Grid.Column="1" Width="130" SelectionChanged="StickCombo_OnSelectionChanged">
                        <ComboBoxItem Content="关闭" Tag="off" />
                        <ComboBoxItem Content="左摇杆" Tag="left" />
                        <ComboBoxItem Content="右摇杆" Tag="right" />
                    </ComboBox>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="灵敏度" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock x:Name="SensText" FontSize="11" Foreground="{DynamicResource Text}" Margin="6,0,0,0" />
                        </StackPanel>
                        <Slider x:Name="SensSlider" Minimum="0.1" Maximum="5" Value="1" Margin="0,4,0,0"
                                ValueChanged="SettingSlider_OnValueChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="加速度" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock x:Name="AccelText" FontSize="11" Foreground="{DynamicResource Text}" Margin="6,0,0,0" />
                        </StackPanel>
                        <Slider x:Name="AccelSlider" Minimum="0" Maximum="1" Value="0.2" Margin="0,4,0,0"
                                ValueChanged="SettingSlider_OnValueChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="死区" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock x:Name="DeadText" FontSize="11" Foreground="{DynamicResource Text}" Margin="6,0,0,0" />
                        </StackPanel>
                        <Slider x:Name="DeadSlider" Minimum="0" Maximum="40" Value="25" Margin="0,4,0,0"
                                ValueChanged="SettingSlider_OnValueChanged" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <ListBox x:Name="BindingList">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,2" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding SourceCategory}" Style="{StaticResource Muted}" FontSize="10" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="→" Foreground="#4B5468" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Surface2}" CornerRadius="5" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ActionKind}" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                    </Border>
                                    <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" Foreground="{DynamicResource Text}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="编辑" Style="{StaticResource BtnBase}" Padding="10,4" FontSize="11" Click="Edit_OnClick" />
                                    <Button Content="删除" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11"
                                            Foreground="{DynamicResource TextMuted}" Click="Delete_OnClick" Margin="4,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="这一层还没有映射。点击右上角“添加映射”开始。"
                           Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

