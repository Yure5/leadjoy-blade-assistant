<UserControl x:Class="LeadjoyBlade.App.Views.FantasyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:LeadjoyBlade.App.Controls"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,14,18">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="幻想模式" Style="{StaticResource H1}" />
                    <ToggleButton x:Name="EnableSwitch" Style="{StaticResource Switch}" Margin="18,4,0,0"
                                  Checked="Enable_OnChanged" Unchecked="Enable_OnChanged" />
                    <TextBlock x:Name="EnableText" Text="关闭" Style="{StaticResource Muted}" Margin="8,4,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="当前热键栏" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="SetCombo" Width="110" SelectionChanged="SetCombo_OnSelectionChanged" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                                ToolTip="显示/隐藏悬浮窗（快捷键 LT+SELECT）">
                        <TextBlock Text="悬浮窗" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <ToggleButton x:Name="OverlayToggle" Width="42" Height="22" Margin="7,0,0,0"
                                      Cursor="Hand" Checked="OverlayToggle_OnChanged" Unchecked="OverlayToggle_OnChanged">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Width="42" Height="22">
                                        <Border x:Name="Track" Background="{DynamicResource Surface2}"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="11" />
                                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#FFF3E6D0"
                                                 HorizontalAlignment="Left" Margin="3,0,0,0" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Track" Property="Background" Value="#FFC8A46A" />
                                            <Setter TargetName="Track" Property="BorderBrush" Value="#FFF3D99A" />
                                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Track" Property="BorderBrush" Value="#FFF3D99A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Height="500">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="GroupCombo" SelectionChanged="GroupCombo_OnSelectionChanged" />
                            <Button Grid.Column="1" Content="＋组" Style="{StaticResource GhostButton}" Padding="8,3" Margin="6,0,0,0" Click="AddGroup_OnClick" />
                            <Button Grid.Column="2" Content="重命名" Style="{StaticResource GhostButton}" Padding="8,3" Margin="4,0,0,0" Click="RenameGroup_OnClick" />
                            <Button Grid.Column="3" Content="删除" Style="{StaticResource GhostButton}" Padding="8,3" Margin="4,0,0,0" Click="DeleteGroup_OnClick" />
                        </Grid>
                        <Button Grid.Row="1" Content="＋ 新建映射" Style="{StaticResource PrimaryButton}" Padding="10,5" Margin="0,8,0,8" Click="AddItem_OnClick" />
                        <Grid Grid.Row="2">
                            <ListBox x:Name="ItemList" MouseDoubleClick="ItemList_OnDoubleClick"
                                     SelectionMode="Extended"
                                     AllowDrop="True"
                                     DragOver="ItemList_OnDragOver"
                                     DragLeave="ItemList_OnDragLeave"
                                     Drop="ItemList_OnDrop"
                                     PreviewMouseLeftButtonDown="ItemList_OnPreviewMouseLeftButtonDown"
                                     PreviewMouseLeftButtonUp="ItemList_OnPreviewMouseLeftButtonUp"
                                     PreviewMouseMove="ItemList_OnPreviewMouseMove"
                                     PreviewKeyDown="ItemList_OnPreviewKeyDown"
                                     PreviewMouseRightButtonDown="ItemList_OnPreviewMouseRightButtonDown">
                                <ListBox.ContextMenu>
                                    <ContextMenu Opened="ItemMenu_OnOpened">
                                        <MenuItem x:Name="EditMenuItem" Header="编辑" Click="EditItem_OnClick" />
                                        <Separator x:Name="MenuSep1" />
                                        <MenuItem x:Name="CutMenuItem" Header="剪切" InputGestureText="Ctrl+X" Click="CutItem_OnClick" />
                                        <MenuItem x:Name="CopyMenuItem" Header="复制" InputGestureText="Ctrl+C" Click="CopyItem_OnClick" />
                                        <MenuItem x:Name="DeleteMenuItem" Header="删除" InputGestureText="Del" Click="DeleteItem_OnClick" />
                                        <Separator x:Name="MenuSep2" />
                                        <MenuItem x:Name="PasteMenuItem" Header="粘贴" InputGestureText="Ctrl+V" Click="PasteItem_OnClick" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,3" Opacity="{Binding RowOpacity}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CutLabel}" Foreground="{DynamicResource Danger}"
                                                           FontSize="10" Margin="6,1,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ActionText}" Style="{StaticResource Muted}" FontSize="10" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Canvas x:Name="BandLayer" IsHitTestVisible="False" Panel.ZIndex="50">
                                <Border x:Name="BandBorder" Visibility="Collapsed"
                                        Background="#33FFD98A" BorderBrush="#FFD98A" BorderThickness="1" />
                            </Canvas>
                            <Border x:Name="DropLine" Height="2" Visibility="Collapsed" IsHitTestVisible="False"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Top" Panel.ZIndex="51"
                                    Background="#FF8B94A8" />
                        </Grid>
                        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                            <Button Content="编辑" Style="{StaticResource BtnBase}" Padding="7,4" FontSize="11" Click="EditItem_OnClick" />
                            <Button Content="剪切" Style="{StaticResource BtnBase}" Padding="7,4" FontSize="11" Margin="4,0,0,0" Click="CutItem_OnClick" />
                            <Button Content="复制" Style="{StaticResource BtnBase}" Padding="7,4" FontSize="11" Margin="4,0,0,0" Click="CopyItem_OnClick" />
                            <Button Content="删除" Style="{StaticResource BtnBase}" Padding="7,4" FontSize="11" Margin="4,0,0,0" Click="DeleteItem_OnClick" />
                            <Button x:Name="UndoButton" Content="撤回" Style="{StaticResource BtnBase}" Padding="7,4" FontSize="11" Margin="4,0,0,0" Click="Undo_OnClick" IsEnabled="False" />
                            <Button x:Name="RedoButton" Content="重做" Style="{StaticResource BtnBase}" Padding="7,4" FontSize="11" Margin="4,0,0,0" Click="Redo_OnClick" IsEnabled="False" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="双十字热键栏" Style="{StaticResource H2}" FontSize="13" />
                            <TextBlock x:Name="PreviewSetText" Text="热键栏 1" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="11" />
                        </Grid>
                        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,8"
                                 VerticalAlignment="Center" HorizontalAlignment="Center">
                            <controls:FantasyHotbarView x:Name="Hotbar" />
                        </Viewbox>
                        <StackPanel Grid.Row="2">
                            <TextBlock x:Name="LockHint" Text="" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" />
                            <TextBlock Text="按住 LT/RT 时在双十字中心显示提示；LT+RT 打开扩展页"
                                       Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="RB 点按显示：" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                        <WrapPanel x:Name="VisibleSetsPanel" Margin="6,0,0,0" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox x:Name="ExtensionCheck" Content="按键扩展增强" Click="Setting_OnChanged" VerticalAlignment="Center" />
                        <TextBlock Text="LT→RT 左半页" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="14,0,4,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="LeftExtensionCombo" Width="104" SelectionChanged="Setting_OnChanged" />
                        <TextBlock Text="RT→LT 右半页" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="12,0,4,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="RightExtensionCombo" Width="104" SelectionChanged="Setting_OnChanged" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="灵敏度档位" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="SensitivityBox" Width="160" FontSize="11" LostFocus="Setting_OnChanged" />
                        <TextBlock Text="切换键" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <ComboBox x:Name="SensitivityKeyCombo" Width="100" SelectionChanged="SensitivityKey_OnChanged">
                            <ComboBoxItem Content="CAPTURE" Tag="Capture" />
                            <ComboBoxItem Content="C" Tag="C" />
                        </ComboBox>
                        <TextBlock Text="左摇杆" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="12,0,6,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="LeftStickCombo" Width="86" SelectionChanged="Setting_OnChanged" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox x:Name="OverlayVisibleCheck" Content="显示悬浮窗" Margin="0,0,12,0" Click="OverlaySetting_OnChanged" />
                        <CheckBox x:Name="ClickThroughCheck" Content="鼠标穿透" Margin="0,0,12,0" Click="OverlaySetting_OnChanged" />
                        <TextBlock Text="缩放" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Slider x:Name="OverlayScaleSlider" Width="80" Minimum="0.1" Maximum="1.5" Value="1"
                                ValueChanged="OverlaySlider_OnChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="OverlayScaleText" Text="100%" Style="{StaticResource Muted}" FontSize="10" Width="38" VerticalAlignment="Center" />
                        <TextBlock Text="透明度" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <Slider x:Name="OverlayOpacitySlider" Width="80" Minimum="0" Maximum="1" Value="0.9"
                                ValueChanged="OverlaySlider_OnChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="OverlayOpacityText" Text="90%" Style="{StaticResource Muted}" FontSize="10" Width="34" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox x:Name="HotbarSoundCheck" Content="热键栏切换音效" Margin="0,0,14,0"
                                  VerticalAlignment="Center" Click="SoundEnabled_OnChanged" />
                        <TextBlock Text="音量" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Slider x:Name="HotbarSoundVolumeSlider" Width="80" Minimum="0" Maximum="100" Value="100"
                                ValueChanged="SoundVolume_OnChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="HotbarSoundVolumeText" Text="100%" Style="{StaticResource Muted}" FontSize="10" Width="38" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="基础键位" Style="{StaticResource H2}" FontSize="13" />
                    <WrapPanel x:Name="BaseKeysPanel" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="系统菜单" Style="{StaticResource H2}" FontSize="13" />
                            <CheckBox x:Name="SystemMenuCheck" Content="启用系统菜单" Margin="16,0,0,0"
                                      VerticalAlignment="Center" Click="SystemMenuSetting_OnChanged" />
                        </StackPanel>
                        <Button x:Name="EditSystemMenuButton" Content="编辑菜单与项目…"
                                Style="{StaticResource BtnBase}" Padding="10,5" FontSize="11"
                                HorizontalAlignment="Right" Click="EditSystemMenu_OnClick" />
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="呼出键" Foreground="{DynamicResource TextMuted}" FontSize="11"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="SystemMenuHotkeyCombo" Width="104" Margin="7,0,16,0"
                                  SelectionChanged="SystemMenuSetting_OnChanged">
                            <ComboBoxItem Content="SELECT" Tag="Select" />
                            <ComboBoxItem Content="START" Tag="Start" />
                        </ComboBox>
                        <TextBlock Text="确认键" Foreground="{DynamicResource TextMuted}" FontSize="11"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="SystemMenuConfirmCombo" Width="84" Margin="7,0,16,0"
                                  SelectionChanged="SystemMenuSetting_OnChanged">
                            <ComboBoxItem Content="A" Tag="A" />
                            <ComboBoxItem Content="B" Tag="B" />
                            <ComboBoxItem Content="X" Tag="X" />
                            <ComboBoxItem Content="Y" Tag="Y" />
                        </ComboBox>
                        <TextBlock Text="取消键" Foreground="{DynamicResource TextMuted}" FontSize="11"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="SystemMenuCancelCombo" Width="84" Margin="7,0,0,0"
                                  SelectionChanged="SystemMenuSetting_OnChanged">
                            <ComboBoxItem Content="A" Tag="A" />
                            <ComboBoxItem Content="B" Tag="B" />
                            <ComboBoxItem Content="X" Tag="X" />
                            <ComboBoxItem Content="Y" Tag="Y" />
                        </ComboBox>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox x:Name="MenuSoundCheck" Content="菜单呼出音效" Margin="0,0,14,0"
                                  VerticalAlignment="Center" Click="SoundEnabled_OnChanged" />
                        <TextBlock Text="音量" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Slider x:Name="MenuSoundVolumeSlider" Width="80" Minimum="0" Maximum="100" Value="100"
                                ValueChanged="SoundVolume_OnChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="MenuSoundVolumeText" Text="100%" Style="{StaticResource Muted}" FontSize="10" Width="38" VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

