    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="连接与测试" Style="{StaticResource H1}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="CardsGrid" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：设备 -->
                    <Border x:Name="LeftCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource Surface}" CornerRadius="10" Height="190" ClipToBounds="True">
                            <Grid>
                                <Image x:Name="ControllerImage" Source="pack://application:,,,/LeadjoyBlade;component/Assets/blade_plus.png" Stretch="Uniform" Margin="18" />
                                <Border x:Name="ImageOverlay" Background="#99000000" Visibility="Collapsed">
                                    <TextBlock Text="未连接" Foreground="#B9C0CF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="ConnectButton" Content="连接选中设备" Style="{StaticResource PrimaryButton}"
                                    Click="ConnectButton_OnClick" />
                            <Button Content="重新扫描" Style="{StaticResource BtnBase}" Margin="8,0,0,0" Click="RefreshButton_OnClick" />
                            <Button x:Name="DisconnectButton" Content="断开" Style="{StaticResource BtnBase}" Margin="8,0,0,0"
                                    Click="DisconnectButton_OnClick" IsEnabled="False" />
                        </StackPanel>

                        <Border Grid.Row="2" Background="{DynamicResource Surface2}" BorderBrush="#3A2529" BorderThickness="1" CornerRadius="8"
                                Padding="10" Margin="0,12,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       Text="全部按键模式：手柄开机等待自动搜索并连接“Blade Plus_1B”(XBOX/DS4/Switch 模式下都会广播)，不要连接“Blade Plus”(G-Touch模式，不会上报任何按键)" />
                        </Border>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ShowAllCheck" Content="显示全部蓝牙设备" VerticalAlignment="Center"
                                      Checked="ShowAllCheck_OnChanged" Unchecked="ShowAllCheck_OnChanged" />
                            <TextBox x:Name="AddressBox" Grid.Column="1" Margin="10,0,0,0" Height="30"
                                     ToolTip="可直接输入 12 位十六进制蓝牙地址，例如 A1B2C3D4E5F6" />
                            <Button Grid.Column="2" Content="按地址连接" Style="{StaticResource BtnBase}" Padding="10,5"
                                    Margin="6,0,0,0" Click="ConnectAddress_OnClick" />
                        </Grid>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="蓝牙自检（10 秒）" Style="{StaticResource BtnBase}" Padding="10,5"
                                    Click="BleSelfTest_OnClick" />
                            <Button Content="打开 Windows 蓝牙设置" Style="{StaticResource GhostButton}" Padding="10,5"
                                    Margin="6,0,0,0" Click="OpenBleSettings_OnClick" />
                        </StackPanel>

                        <TextBlock Grid.Row="5" Text="发现的手柄" Style="{StaticResource H2}" Margin="0,16,0,6" />
                        <ListBox Grid.Row="7" x:Name="CandidateList" MinHeight="60" MouseDoubleClick="CandidateList_OnDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BrandBadge" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Surface2}">
                                            <Viewbox Margin="7">
                                                <Grid Width="24" Height="24">
                                                    <Path x:Name="BrandPath" Data="{StaticResource IconHid}" Fill="White"
                                                          Stretch="Uniform" />
                                                    <Path x:Name="SwitchVector" Data="{StaticResource IconSwitch}" Fill="White"
                                                          Stretch="Uniform" Visibility="Collapsed" />
                                                    <Image x:Name="BladeImage"
                                                           Source="pack://application:,,,/LeadjoyBlade;component/Assets/blade_logo.png"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Stretch="Uniform" Visibility="Collapsed">
                                                        <Image.RenderTransform>
                                                            <TranslateTransform X="0.8" Y="-0.3" />
                                                        </Image.RenderTransform>
                                                    </Image>
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Id}" Style="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource Surface2}" CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="{Binding KindText}" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding RssiText}" FontSize="9" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ModeKey}" Value="xbox">
                                            <Setter TargetName="BrandBadge" Property="Background" Value="#107C10" />
                                            <Setter TargetName="BrandPath" Property="Data" Value="{StaticResource IconXbox}" />
                                            <Setter TargetName="BrandPath" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.08" ScaleY="1.08" CenterX="12" CenterY="12" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ModeKey}" Value="ds4">
                                            <Setter TargetName="BrandBadge" Property="Background" Value="#003791" />
                                            <Setter TargetName="BrandPath" Property="Data" Value="{StaticResource IconPs}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ModeKey}" Value="switch">
                                            <Setter TargetName="BrandBadge" Property="Background" Value="#E60012" />
                                            <Setter TargetName="BrandPath" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="SwitchVector" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ModeKey}" Value="ble">
                                            <Setter TargetName="BrandBadge" Property="Background" Value="#570F8C" />
                                            <Setter TargetName="BrandPath" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="BladeImage" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="6" x:Name="EmptyHint" Text="正在扫描… 请等 “Blade Plus_1B” 出现（Xbox / DS4 / Switch 模式都会广播；标准模式只提供标准键）；也可插入 USB 线"
                                   Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- 右：实时测试 -->
                <Border x:Name="RightCard" Grid.Column="2" Grid.Row="0" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="按键测试" Style="{StaticResource H2}" />
                            <TextBlock x:Name="ReportRateText" Text="0 Hz" Style="{StaticResource Muted}"
                                       HorizontalAlignment="Right" MinWidth="54" TextAlignment="Right" />
                        </Grid>

                        <WrapPanel Grid.Row="1" x:Name="ButtonChips" Margin="0,14,0,0" HorizontalAlignment="Center" />

                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="左摇杆" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                                <Border Width="112" Height="112" CornerRadius="56" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" Margin="0,8,0,0">
                                    <Canvas x:Name="LeftStickCanvas" Width="112" Height="112">
                                        <Ellipse Width="112" Height="112" Stroke="#1E2532" StrokeThickness="1" />
                                        <Ellipse x:Name="LeftDeadzoneRing" Fill="{DynamicResource TextMuted}" Opacity="0.22"
                                                 Visibility="Collapsed" />
                                        <Ellipse x:Name="LeftStickDot" Width="18" Height="18" Fill="#FF4D4F"
                                                 Canvas.Left="47" Canvas.Top="47" />
                                    </Canvas>
                                </Border>
                                <TextBlock x:Name="LeftStickText" Text="0, 0" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="右摇杆" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                                <Border Width="112" Height="112" CornerRadius="56" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" Margin="0,8,0,0">
                                    <Canvas x:Name="RightStickCanvas" Width="112" Height="112">
                                        <Ellipse Width="112" Height="112" Stroke="#1E2532" StrokeThickness="1" />
                                        <Ellipse x:Name="RightDeadzoneRing" Fill="{DynamicResource TextMuted}" Opacity="0.22"
                                                 Visibility="Collapsed" />
                                        <Ellipse x:Name="RightStickDot" Width="18" Height="18" Fill="#5B8CFF"
                                                 Canvas.Left="47" Canvas.Top="47" />
                                    </Canvas>
                                </Border>
                                <TextBlock x:Name="RightStickText" Text="0, 0" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="3">
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LT" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Width="26" />
                            <ProgressBar x:Name="LeftTriggerBar" Grid.Column="1" Maximum="100" />
                            <TextBlock x:Name="LeftTriggerText" Grid.Column="2" Text="0" HorizontalAlignment="Right"
                                       Style="{StaticResource Muted}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RT" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Width="26" />
                            <ProgressBar x:Name="RightTriggerBar" Grid.Column="1" Maximum="100" Foreground="{DynamicResource Accent2}" />
                            <TextBlock x:Name="RightTriggerText" Grid.Column="2" Text="0" HorizontalAlignment="Right"
                                       Style="{StaticResource Muted}" />
                        </Grid>
                        </StackPanel>

                        <Border Grid.Row="4" Style="{StaticResource Divider}" />
                        <TextBlock Grid.Row="5" Text="原始报文" Style="{StaticResource Muted}" />
                        <TextBlock Grid.Row="6" x:Name="RawReportText" Text="—" FontFamily="Consolas" FontSize="11"
                                   Height="54" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </Grid>
                </Border>
                </Grid>
    </Grid>
</UserControl>






