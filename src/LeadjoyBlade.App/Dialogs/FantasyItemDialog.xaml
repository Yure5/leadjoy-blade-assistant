<Window x:Class="LeadjoyBlade.App.Dialogs.FantasyItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LeadjoyBlade.App.Controls"
        Title="编辑幻想映射" Width="640" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Surface2}" CornerRadius="14,14,0,0" Padding="18,14"
                    MouseLeftButtonDown="Title_OnMouseDown">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="编辑幻想映射" FontSize="15" FontWeight="SemiBold" />
                    <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Cancel_OnClick" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="700" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="名称" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <TextBox x:Name="NameBox" Grid.Column="1" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="图标" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="96" Background="{DynamicResource Surface2}" CornerRadius="8" ClipToBounds="True">
                            <Image x:Name="IconPreview" Stretch="Uniform" ClipToBounds="True"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <Button Content="上传图片" Style="{StaticResource BtnBase}" Padding="10,5" Click="PickImage_OnClick" />
                            <Button Content="清除图片" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,6,0,0" Click="ClearImage_OnClick" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="图标文字" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <TextBox x:Name="IconTextBox" Grid.Column="1" MaxLength="2" TextChanged="IconText_OnChanged" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="背景色" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <TextBox x:Name="IconColorBox" Grid.Column="1" ToolTip="例如 #8B3A3A" TextChanged="ColorText_OnChanged" />
                        <Border x:Name="ColorPreview" Grid.Column="2" Width="28" Height="28" Margin="8,0,0,0"
                                CornerRadius="6" BorderBrush="{DynamicResource Border}" BorderThickness="1" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="常用色" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <WrapPanel x:Name="SwatchesPanel" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="色彩调节" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="R" Foreground="{DynamicResource TextMuted}" FontSize="10" VerticalAlignment="Center" />
                            <Slider x:Name="RedSlider" Width="66" Minimum="0" Maximum="255" Margin="4,0,0,0"
                                    ValueChanged="ColorSlider_OnChanged" VerticalAlignment="Center" />
                            <TextBlock x:Name="RedText" Width="26" FontSize="10" VerticalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="G" Foreground="{DynamicResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <Slider x:Name="GreenSlider" Width="66" Minimum="0" Maximum="255" Margin="4,0,0,0"
                                    ValueChanged="ColorSlider_OnChanged" VerticalAlignment="Center" />
                            <TextBlock x:Name="GreenText" Width="26" FontSize="10" VerticalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="B" Foreground="{DynamicResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <Slider x:Name="BlueSlider" Width="66" Minimum="0" Maximum="255" Margin="4,0,0,0"
                                    ValueChanged="ColorSlider_OnChanged" VerticalAlignment="Center" />
                            <TextBlock x:Name="BlueText" Width="26" FontSize="10" VerticalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <controls:ActionEditor x:Name="Editor" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="78" Click="Cancel_OnClick" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" MinWidth="78" Margin="8,0,0,0" Click="Save_OnClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
