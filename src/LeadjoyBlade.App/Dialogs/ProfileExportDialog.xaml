<Window x:Class="LeadjoyBlade.App.Dialogs.ProfileExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出配置" Width="420" Height="420" SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Surface}" CornerRadius="14,14,0,0" Padding="18,14"
                    MouseLeftButtonDown="Title_OnMouseDown">
                <Grid>
                    <TextBlock Text="导出配置" FontSize="15" FontWeight="SemiBold" />
                    <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Cancel_OnClick" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,12">
                <TextBlock Text="选择要导出的配置，可按住 Ctrl / Shift 多选。" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8" />
                <ListBox x:Name="ProfileList" Height="240" SelectionMode="Extended" />
                <Button Content="全选" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        Padding="10,4" FontSize="11" Margin="0,8,0,0" Click="SelectAll_OnClick" />
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="78" Click="Cancel_OnClick" />
                    <Button Content="导出" Style="{StaticResource PrimaryButton}" MinWidth="78" Margin="8,0,0,0" Click="Export_OnClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
