<Window x:Class="LeadjoyBlade.App.Dialogs.ChordEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LeadjoyBlade.App.Controls"
        Title="编辑组合键" Width="620" SizeToContent="Height" MaxHeight="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Surface}" CornerRadius="14,14,0,0" Padding="18,14" MouseLeftButtonDown="Title_OnMouseDown">
                <Grid>
                    <TextBlock Text="编辑组合键" FontSize="15" FontWeight="SemiBold" />
                    <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Cancel_OnClick" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="名称" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <TextBox x:Name="NameBox" Grid.Column="1" Text="组合键" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="同时按下" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock x:Name="CaptureHint" Grid.Column="1" Text="勾选 2 个以上按键，或直接从手柄捕获" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="从手柄捕获" Style="{StaticResource BtnBase}" Padding="10,5"
                                Click="Capture_OnClick" />
                    </Grid>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <ItemsControl x:Name="SourceList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Margin="0,2" FontSize="11" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </Border>

                    <Border Style="{StaticResource Divider}" />
                    <controls:ActionEditor x:Name="Editor" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_OnClick" MinWidth="78" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_OnClick" MinWidth="78" Margin="8,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>


