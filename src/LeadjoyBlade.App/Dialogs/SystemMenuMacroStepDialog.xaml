<Window x:Class="LeadjoyBlade.App.Dialogs.SystemMenuMacroStepDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑宏步骤" Width="560" SizeToContent="Height" MaxHeight="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Focusable="True" PreviewKeyDown="OnPreviewKeyDown">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Surface2}" CornerRadius="14,14,0,0" Padding="18,14"
                    MouseLeftButtonDown="Title_OnMouseDown">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="编辑宏步骤" FontSize="15" FontWeight="SemiBold" />
                    <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Cancel_OnClick" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="620" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16">
                    <StackPanel x:Name="KeyPanel">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="键盘按键" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <TextBlock x:Name="KeyText" Text="Space" />
                            </Border>
                            <Button Grid.Column="2" Content="捕获按键" Style="{StaticResource BtnBase}" Margin="8,0,0,0"
                                    Click="CaptureKey_OnClick" />
                        </Grid>
                        <WrapPanel Margin="86,0,0,4">
                            <CheckBox x:Name="CtrlCheck" Content="Ctrl" Margin="0,0,14,0" />
                            <CheckBox x:Name="AltCheck" Content="Alt" Margin="0,0,14,0" />
                            <CheckBox x:Name="ShiftCheck" Content="Shift" Margin="0,0,14,0" />
                            <CheckBox x:Name="WinCheck" Content="Win" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel x:Name="GamepadPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="手柄按键（可多选）" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            <Button x:Name="CaptureGamepadButton" Content="捕获按键" Style="{StaticResource BtnBase}"
                                    Padding="8,4" FontSize="10" HorizontalAlignment="Right" Click="CaptureGamepad_OnClick" />
                        </Grid>
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="8" Padding="4">
                            <ListBox x:Name="GamepadList" Height="150" SelectionMode="Multiple"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="12" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="MousePanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="相对位置" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="X" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="MouseXBox" Width="58" Text="50" />
                                <TextBlock Text="%" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                                <TextBlock Text="Y" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox x:Name="MouseYBox" Width="58" Text="50" />
                                <TextBlock Text="%" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="设置鼠标位置" Style="{StaticResource BtnBase}" Padding="9,5"
                                    Margin="10,0,0,0" Click="PickMousePosition_OnClick" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="鼠标按键" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            <ComboBox x:Name="MouseButtonCombo" Grid.Column="1" Width="160" HorizontalAlignment="Left">
                                <ComboBoxItem Content="左键" Tag="Left" />
                                <ComboBoxItem Content="右键" Tag="Right" />
                                <ComboBoxItem Content="中键" Tag="Middle" />
                                <ComboBoxItem Content="侧键 1" Tag="X1" />
                                <ComboBoxItem Content="侧键 2" Tag="X2" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="TextPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="要输入的文字" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" Margin="0,7,0,0" />
                            <TextBox x:Name="ActionTextBox" Grid.Column="1" Height="76" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     ToolTip="执行这一步时输入这段文字" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="DelayPanel" Visibility="Collapsed">
                        <TextBlock Text="延迟步骤只等待指定时间，不发送任何按键。" Style="{StaticResource Muted}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                    </StackPanel>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="按住 / 间隔" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="按住" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="HoldBox" Width="58" Text="60" />
                            <TextBlock Text="ms" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,10,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,0,0">
                            <TextBlock Text="间隔" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="DelayBox" Width="58" Text="80" />
                            <TextBlock Text="ms" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_OnClick" MinWidth="78" />
                    <Button Content="确定" Style="{StaticResource PrimaryButton}" Click="Save_OnClick" MinWidth="78" Margin="8,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

