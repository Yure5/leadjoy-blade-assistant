<Window x:Class="LeadjoyBlade.App.Dialogs.SystemMenuEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑系统菜单" Width="980" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Surface2}" CornerRadius="14,14,0,0" Padding="18,14"
                    MouseLeftButtonDown="Title_OnMouseDown">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="编辑系统菜单" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="菜单栏是顶部横向分类，项目是当前菜单栏下方的纵向列表；项目动作只在系统菜单内生效。"
                                   Style="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Cancel_OnClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="菜单栏" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="CategoryCountText" Text="" Style="{StaticResource Muted}" FontSize="10"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Button Grid.Row="1" Content="＋ 新建菜单" Style="{StaticResource PrimaryButton}"
                                Padding="10,5" Margin="0,0,0,8" Click="AddCategory_OnClick" />
                        <ListBox x:Name="CategoryList" Grid.Row="2" SelectionMode="Single"
                                 SelectionChanged="CategoryList_OnSelectionChanged"
                                 PreviewMouseRightButtonDown="CategoryList_OnPreviewMouseRightButtonDown"
                                 PreviewKeyDown="CategoryList_OnPreviewKeyDown">
                            <ListBox.ContextMenu>
                                <ContextMenu x:Name="CategoryMenu" Opened="CategoryMenu_OnOpened">
                                    <MenuItem x:Name="CategoryRenameMenuItem" Header="编辑 / 重命名" Click="RenameCategory_OnClick" />
                                    <Separator x:Name="CategoryMenuSep1" />
                                    <MenuItem x:Name="CategoryCutMenuItem" Header="剪切" InputGestureText="Ctrl+X" Click="CutCategory_OnClick" />
                                    <MenuItem x:Name="CategoryCopyMenuItem" Header="复制" InputGestureText="Ctrl+C" Click="CopyCategory_OnClick" />
                                    <MenuItem x:Name="CategoryDeleteMenuItem" Header="删除" InputGestureText="Del" Click="DeleteCategory_OnClick" />
                                    <Separator x:Name="CategoryMenuSep2" />
                                    <MenuItem x:Name="CategoryPasteMenuItem" Header="粘贴" InputGestureText="Ctrl+V" Click="PasteCategory_OnClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,3" Opacity="{Binding RowOpacity}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CutLabel}" Foreground="{DynamicResource Danger}"
                                                   FontSize="10" Margin="6,1,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                            <Button x:Name="CategoryRenameButton" Content="重命名" Style="{StaticResource BtnBase}" Padding="8,4" FontSize="11"
                                    Click="RenameCategory_OnClick" />
                            <Button x:Name="CategoryCutButton" Content="剪切" Style="{StaticResource BtnBase}" Padding="8,4" FontSize="11"
                                    Margin="4,0,0,0" Click="CutCategory_OnClick" />
                            <Button x:Name="CategoryCopyButton" Content="复制" Style="{StaticResource BtnBase}" Padding="8,4" FontSize="11"
                                    Margin="4,0,0,0" Click="CopyCategory_OnClick" />
                            <Button x:Name="CategoryDeleteButton" Content="删除" Style="{StaticResource BtnBase}" Padding="8,4" FontSize="11"
                                    Margin="4,0,0,0" Click="DeleteCategory_OnClick" />
                            <Button Content="↑" Style="{StaticResource BtnBase}" Padding="8,4" FontSize="11"
                                    Margin="10,0,0,0" Click="MoveCategoryUp_OnClick" />
                            <Button Content="↓" Style="{StaticResource BtnBase}" Padding="8,4" FontSize="11"
                                    Margin="4,0,0,0" Click="MoveCategoryDown_OnClick" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CategoryHeader" Text="项目" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="CategoryMeta" Text="" Style="{StaticResource Muted}" FontSize="10"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <Button Grid.Row="1" Content="＋ 新建项目" Style="{StaticResource PrimaryButton}"
                                Padding="10,5" Margin="0,0,0,8" Click="AddItem_OnClick" />
                        <ListBox x:Name="ItemList" Grid.Row="2" SelectionMode="Extended"
                                 SelectionChanged="ItemList_OnSelectionChanged"
                                 MouseDoubleClick="ItemList_OnMouseDoubleClick"
                                 PreviewMouseRightButtonDown="ItemList_OnPreviewMouseRightButtonDown"
                                 PreviewKeyDown="ItemList_OnPreviewKeyDown">
                            <ListBox.ContextMenu>
                                <ContextMenu x:Name="ItemMenu" Opened="ItemMenu_OnOpened">
                                    <MenuItem x:Name="ItemEditMenuItem" Header="编辑" Click="EditItem_OnClick" />
                                    <Separator x:Name="ItemMenuSep1" />
                                    <MenuItem x:Name="ItemCutMenuItem" Header="剪切" InputGestureText="Ctrl+X" Click="CutItem_OnClick" />
                                    <MenuItem x:Name="ItemCopyMenuItem" Header="复制" InputGestureText="Ctrl+C" Click="CopyItem_OnClick" />
                                    <MenuItem x:Name="ItemDeleteMenuItem" Header="删除" InputGestureText="Del" Click="DeleteItem_OnClick" />
                                    <Separator x:Name="ItemMenuSep2" />
                                    <MenuItem x:Name="ItemPasteMenuItem" Header="粘贴" InputGestureText="Ctrl+V" Click="PasteItem_OnClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,2" Opacity="{Binding RowOpacity}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CutLabel}" Foreground="{DynamicResource Danger}"
                                                       FontSize="10" Margin="6,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ActionText}" Style="{StaticResource Muted}" FontSize="10"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                            <Button x:Name="ItemEditButton" Content="编辑" Style="{StaticResource BtnBase}" Padding="8,4" FontSize="11"
                                    Click="EditItem_OnClick" />
                            <Button x:Name="ItemCutButton" Content="剪切" Style="{StaticResource BtnBase}" Padding="8,4" FontSize="11"
                                    Margin="4,0,0,0" Click="CutItem_OnClick" />
                            <Button x:Name="ItemCopyButton" Content="复制" Style="{StaticResource BtnBase}" Padding="8,4" FontSize="11"
                                    Margin="4,0,0,0" Click="CopyItem_OnClick" />
                            <Button x:Name="ItemDeleteButton" Content="删除" Style="{StaticResource BtnBase}" Padding="8,4" FontSize="11"
                                    Margin="4,0,0,0" Click="DeleteItem_OnClick" />
                            <Button Content="↑" Style="{StaticResource BtnBase}" Padding="8,4" FontSize="11"
                                    Margin="10,0,0,0" Click="MoveItemUp_OnClick" />
                            <Button Content="↓" Style="{StaticResource BtnBase}" Padding="8,4" FontSize="11"
                                    Margin="4,0,0,0" Click="MoveItemDown_OnClick" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_OnClick" MinWidth="78" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_OnClick" MinWidth="78" Margin="8,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
