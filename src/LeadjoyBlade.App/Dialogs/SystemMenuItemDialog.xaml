<Window x:Class="LeadjoyBlade.App.Dialogs.SystemMenuItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LeadjoyBlade.App.Controls"
        Title="编辑系统菜单项目" Width="700" SizeToContent="Height" MaxHeight="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Surface2}" CornerRadius="14,14,0,0" Padding="18,14"
                    MouseLeftButtonDown="Title_OnMouseDown">
                <Grid>
                    <TextBlock Text="编辑系统菜单项目" FontSize="15" FontWeight="SemiBold" />
                    <Button Content="✕" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="Cancel_OnClick" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="680" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="项目名称" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <TextBox x:Name="NameBox" Grid.Column="1" />
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="项目说明" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" Margin="0,7,0,0" />
                        <TextBox x:Name="DescriptionBox" Grid.Column="1" Height="56" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                    </Grid>
                    <controls:SystemMenuActionEditor x:Name="Editor" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_OnClick" MinWidth="78" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_OnClick" MinWidth="78" Margin="8,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
