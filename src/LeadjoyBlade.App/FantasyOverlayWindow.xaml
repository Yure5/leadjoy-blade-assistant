<Window x:Class="LeadjoyBlade.App.FantasyOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LeadjoyBlade.App.Controls"
        Title="幻想模式悬浮窗" Width="984" Height="318" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowActivated="False">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ChromeRow" Height="24" />
            <RowDefinition x:Name="SelectorRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="DragBar" Background="#CC0D1119" CornerRadius="10,10,0,0"
                BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="DragBar_OnMouseDown" MouseLeftButtonUp="DragBar_OnMouseUp">
            <Grid>
                <TextBlock x:Name="TitleText" Text="幻想模式" Foreground="#9AA4B8" FontSize="10"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="拖动此处移动" Foreground="#5E6A7E" FontSize="9" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
            </Grid>
        </Border>
        <controls:BarSelectorView x:Name="Selector" Grid.Row="1" Panel.ZIndex="20" HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom" Margin="10,0,10,0" Visibility="Collapsed" />
        <controls:FantasyHotbarView x:Name="Hotbar" Grid.Row="2" Margin="24,4,24,6"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
