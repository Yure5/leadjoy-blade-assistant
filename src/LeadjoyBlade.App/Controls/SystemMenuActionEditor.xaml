<UserControl x:Class="LeadjoyBlade.App.Controls.SystemMenuActionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="映射动作" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
            <ComboBox x:Name="TypeCombo" Grid.Column="1" SelectionChanged="TypeCombo_OnSelectionChanged">
                <ComboBoxItem Content="键盘按键" Tag="Key" />
                <ComboBoxItem Content="手柄按键" Tag="Gamepad" />
                <ComboBoxItem Content="鼠标点击" Tag="MouseClick" />
                <ComboBoxItem Content="文本输入" Tag="Text" />
                <ComboBoxItem Content="独立宏" Tag="Macro" />
            </ComboBox>
        </Grid>

        <!-- 键盘 -->
        <StackPanel x:Name="KeyPanel">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="键盘按键" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                        BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <TextBlock x:Name="KeyText" Text="Space" />
                </Border>
                <Button Grid.Column="2" Content="捕获按键" Style="{StaticResource BtnBase}" Margin="8,0,0,0"
                        Click="CaptureKey_OnClick" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="修饰键" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox x:Name="CtrlCheck" Content="Ctrl" Margin="0,0,14,0" />
                    <CheckBox x:Name="AltCheck" Content="Alt" Margin="0,0,14,0" />
                    <CheckBox x:Name="ShiftCheck" Content="Shift" Margin="0,0,14,0" />
                    <CheckBox x:Name="WinCheck" Content="Win" />
                </StackPanel>
            </Grid>
            <TextBlock Text="按 Ctrl / Alt / Shift 后再捕获可组成组合键；游戏最终收到的是这里指定的按键。"
                       Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="92,0,0,0" />
        </StackPanel>

        <!-- 手柄 -->
        <StackPanel x:Name="GamepadPanel" Visibility="Collapsed">
            <Grid Margin="0,0,0,6">
                <TextBlock Text="手柄按键（可多选）" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                <Button x:Name="CaptureGamepadButton" Content="捕获按键" Style="{StaticResource BtnBase}"
                        Padding="8,4" FontSize="10" HorizontalAlignment="Right" Click="CaptureGamepad_OnClick" />
            </Grid>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="8" Padding="4">
                <ListBox x:Name="GamepadList" Height="154" SelectionMode="Multiple"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="12" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>

        <!-- 鼠标点击 -->
        <StackPanel x:Name="MousePanel" Visibility="Collapsed">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="相对位置" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="X" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="MouseXBox" Width="62" Text="50" />
                    <TextBlock Text="%" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="Y" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="MouseYBox" Width="62" Text="50" />
                    <TextBlock Text="%" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
                <Button Grid.Column="3" Content="设置鼠标位置" Style="{StaticResource BtnBase}" Padding="10,5"
                        Margin="10,0,0,0" Click="PickMousePosition_OnClick" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="鼠标按键" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                <ComboBox x:Name="MouseButtonCombo" Grid.Column="1" Width="160" HorizontalAlignment="Left">
                    <ComboBoxItem Content="左键" Tag="Left" />
                    <ComboBoxItem Content="右键" Tag="Right" />
                    <ComboBoxItem Content="中键" Tag="Middle" />
                    <ComboBoxItem Content="侧键 1" Tag="X1" />
                    <ComboBoxItem Content="侧键 2" Tag="X2" />
                </ComboBox>
            </Grid>
            <TextBlock Text="「设置鼠标位置」会在游戏窗口上覆盖半透明遮罩供点选：左键落点、拖动准星微调、ESC 保存退出。配置了进程时坐标相对该窗口客户区；未配置进程时按点击所在的显示器记录，多屏不会点错屏幕。"
                       Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,0" />
        </StackPanel>

        <!-- 文本输入 -->
        <StackPanel x:Name="TextPanel" Visibility="Collapsed">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="要输入的文字" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" Margin="0,7,0,0" />
                <TextBox x:Name="ActionTextBox" Grid.Column="1" Height="76" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         ToolTip="执行时通过键盘输入这段文字" />
            </Grid>
            <TextBlock Text="执行项目时会把这段文字送进当前窗口；中文由系统输入法处理，建议在中文输入状态下使用。"
                       Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="92,0,0,0" />
        </StackPanel>

        <!-- 独立宏 -->
        <StackPanel x:Name="MacroPanel" Visibility="Collapsed">
            <TextBlock Text="独立宏步骤（仅这个系统菜单项目使用，不会进入全局宏库，也不会被其他映射调用）"
                       Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="8" Padding="4">
                <StackPanel>
                    <Grid Height="24" Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource Muted}" FontSize="10" Margin="4,0,0,0" />
                        <TextBlock Grid.Column="2" Text="按键 / 内容" Style="{StaticResource Muted}" FontSize="10" Margin="4,0,0,0" />
                        <TextBlock Grid.Column="3" Text="按住(ms)" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="间隔(ms)" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" />
                    </Grid>
                    <ListBox x:Name="StepList" Height="154" SelectionChanged="StepList_OnSelectionChanged"
                             MouseDoubleClick="StepList_OnMouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0,1" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="62" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index}" Style="{StaticResource Muted}" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding KindText}" FontSize="11"
                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                    <Grid Grid.Column="2" Margin="4,0,6,0">
                                        <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}"
                                                BorderThickness="1" CornerRadius="5" Padding="6,2" HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ShowKeyBox, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding KeyText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding KeyText}" />
                                        </Border>
                                        <TextBlock Text="{Binding KeyText}" FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding KeyText}"
                                                   Visibility="{Binding ShowText, Converter={StaticResource BoolVis}}" />
                                        <TextBlock Text="等待" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Visibility="{Binding ShowDelay, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                    <TextBox Grid.Column="3" Text="{Binding Step.HoldMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Height="26" FontSize="11.5" Padding="4,2" Margin="0,0,5,0"
                                             VerticalContentAlignment="Center" ToolTip="按住毫秒"
                                             Visibility="{Binding ShowHold, Converter={StaticResource BoolVis}}" />
                                    <TextBox Grid.Column="4" Text="{Binding Step.DelayMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Height="26" FontSize="11.5" Padding="4,2" VerticalContentAlignment="Center"
                                             ToolTip="间隔毫秒" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="＋ 键盘" Style="{StaticResource BtnBase}" Padding="9,5" Click="AddKeyStep_OnClick" />
                <Button Content="＋ 手柄" Style="{StaticResource BtnBase}" Padding="9,5" Margin="5,0,0,0" Click="AddGamepadStep_OnClick" />
                <Button Content="＋ 鼠标点击" Style="{StaticResource BtnBase}" Padding="9,5" Margin="5,0,0,0" Click="AddMouseStep_OnClick" />
                <Button Content="＋ 文本" Style="{StaticResource BtnBase}" Padding="9,5" Margin="5,0,0,0" Click="AddTextStep_OnClick" />
                <Button Content="＋ 延迟" Style="{StaticResource BtnBase}" Padding="9,5" Margin="5,0,0,0" Click="AddDelayStep_OnClick" />
                <Button Content="编辑" Style="{StaticResource BtnBase}" Padding="9,5" Margin="5,0,0,0" Click="EditStep_OnClick" />
                <Button Content="删除" Style="{StaticResource BtnBase}" Padding="9,5" Margin="5,0,0,0" Click="DeleteStep_OnClick" />
                <Button Content="上移" Style="{StaticResource BtnBase}" Padding="9,5" Margin="5,0,0,0" Click="MoveStepUp_OnClick" />
                <Button Content="下移" Style="{StaticResource BtnBase}" Padding="9,5" Margin="5,0,0,0" Click="MoveStepDown_OnClick" />
            </WrapPanel>
        </StackPanel>
    </StackPanel>
</UserControl>

